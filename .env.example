# Copy to .env (never commit .env). Not needed to edit content.
PORT=8787
# AI assistant (Anthropic API). Leave blank to disable; the chat then shows a fallback.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Contact delivery via Resend (https://resend.com). Leave blank to disable the form honestly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
